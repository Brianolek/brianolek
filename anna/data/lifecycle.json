{
  "_about": "Dated events generated per work. 'anchor' is a date field on the work (started, finished, drop). offsetDays shifts from that date. 'requires' is a boolean field the work must have. Milestones take over the day's regular slot on the same platform so she is not double posting.",
  "rules": [
    { "id": "concept-day",   "anchor": "started",  "offsetDays": 0,  "type": "concept",        "platforms": ["threads"] },
    { "id": "reveal-day",    "anchor": "finished", "offsetDays": 0,  "type": "reveal",         "platforms": ["instagram", "threads"] },
    { "id": "story-after",   "anchor": "finished", "offsetDays": 2,  "type": "story",          "platforms": ["threads"] },
    { "id": "prints-after",  "anchor": "finished", "offsetDays": 5,  "type": "prints",         "platforms": ["instagram", "threads"], "requires": "prints" },
    { "id": "drop-t7",       "anchor": "drop",     "offsetDays": -7, "type": "drop-teaser",    "platforms": ["threads", "instagram"] },
    { "id": "drop-t3",       "anchor": "drop",     "offsetDays": -3, "type": "story",          "platforms": ["threads"] },
    { "id": "drop-t1",       "anchor": "drop",     "offsetDays": -1, "type": "drop-reminder",  "platforms": ["email", "threads", "instagram"] },
    { "id": "drop-t0",       "anchor": "drop",     "offsetDays": 0,  "type": "drop-live",      "platforms": ["email", "threads", "instagram", "tiktok"], "time": "10:00" },
    { "id": "drop-t2",       "anchor": "drop",     "offsetDays": 2,  "type": "drop-last-call", "platforms": ["threads", "instagram"] },
    { "id": "sold-day",      "anchor": "sold",     "offsetDays": 0,  "type": "collector",      "platforms": ["threads", "instagram"] }
  ]
}
